# Kopieren nach .env und Werte anpassen, bevor "docker compose up" ausgeführt wird.

# Pflicht: langer, zufälliger String (z. B. mit `openssl rand -hex 32` erzeugen)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Optional: nur nötig, wenn die App hinter einer eigenen Domain/Reverse-Proxy läuft
# (z. B. https://betten.meine-klinik.local)
CORS_ORIGIN=
