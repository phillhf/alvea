# Konfiguration fuer die Entwicklung (npm run dev).
# Bei Installation ueber das Setup legt der Installer die Datei
# <Installationsordner>\data\alvea.env an – diese Datei wird dann nicht verwendet.

HOST=0.0.0.0
PORT=37843
NODE_ENV=development
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=12h
RETENTION_DAYS=90

# Datenpfade (relativ zum backend-Ordner)
DB_FILE=./data/alvea.sqlite
UPLOAD_DIR=./uploads
LOG_DIR=../logs
LOG_LEVEL=info          # debug | info | warn | error

# Update-Pruefung (GitHub-Repository mit den Releases)
UPDATE_REPO=phillhf/alvea
