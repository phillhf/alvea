{
  "name": "alvea-backend",
  "version": "1.2.0",
  "private": true,
  "description": "Alvea – All-in-One Node Server (API + SPA + SQLite)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "init-db": "tsx src/scripts/init-db.ts",
    "test": "jest --passWithNoTests --detectOpenHandles"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.18.0",
    "pino": "^9.4.0",
    "pino-roll": "^1.0.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.18",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "jest": "^30.0.0",
    "pino-pretty": "^11.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "uuid": "^11.0.0",
    "glob": "^13.0.6",
    "rimraf": "^6.0.0",
    "inflight": "npm:lru-cache@^11.0.0"
  }
}
